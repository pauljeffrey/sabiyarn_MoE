# ONE .env for the whole repo. Copy to .env and fill in. .env is gitignored; this file is not, so never
# put a real key here. data-gen/, training/, rl/, rlhf/ and eval_suite/ all read this same file
# (data-gen/providers/base.py::load_env loads the repo root explicitly, from any working directory).

# ---------------------------------------------------------------- generation providers
# Together AI: has a real batch queue (~50% price, 24h window) -- best for the big pretrain run.
TOGETHER_API_KEY=
# OpenRouter: one key, many models, no batch queue -- throughput comes from concurrency.
OPENROUTER_API_KEY=
# Optional: OpenAI, for the older data-gen/pipeline/* batch scripts.
OPENAI_API_KEY=

# ---------------------------------------------------------------- Hugging Face
# HF_TOKEN needs read for gated eval datasets; HF_WRITE_TOKEN needs write to push models and data.
HF_TOKEN=
HF_WRITE_TOKEN=
HF_API_KEY=

# ---------------------------------------------------------------- platforms
# RunPod: only needed for `runners/runpod_gen.py --launch`. Running ON a pod (or on vast.ai) needs nothing.
RUNPOD_API_KEY=
# Modal reads its own ~/.modal.toml; nothing needed here.

# ---------------------------------------------------------------- training / storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
WANDB_API_KEY=
# MLFLOW_TRACKING_URI=            # unset -> ./mlruns

# ---------------------------------------------------------------- data-gen knobs (optional)
# DATA_GEN_HF_REPO=BeardedMonster/data-gen
# DATA_GEN_OUTPUT_DIR=            # default data-gen/data
# DATA_GEN_SHARDS=1               # set by the runners for parallel workers
# DATA_GEN_SHARD_INDEX=0
